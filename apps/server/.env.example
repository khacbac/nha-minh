# Server (dev/guides/backend.md)
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=debug

# HTTP-level rate limit: max requests per minute per IP (default 120)
# RATE_LIMIT_MAX=120

# Supabase. Local: `pnpm db:start` prints the API URL and the secret key (sb_secret_…);
# production: the project's Settings → API Keys.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SECRET_KEY=
