# Server (dev/guides/backend.md)
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=debug

# HTTP-level rate limit: max requests per minute per IP (default 120)
# RATE_LIMIT_MAX=120

# Supabase production, also in dev: the only database (dev/guides/backend.md §3).
# Supabase → Settings → API Keys.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
