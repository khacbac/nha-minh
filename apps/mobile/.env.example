# Local development (loaded by `expo start`; dev/guides/backend.md §3).
# Empty in dev: the app calls apps/server on the machine Metro runs on, port 3100.
EXPO_PUBLIC_API_URL=

# Sign-in (spec mvp.md §2.0). Local: `pnpm db:start` prints the API URL and the publishable
# key (sb_publishable_…). localhost is rewritten to Metro's host in dev.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
