# Local development (loaded by `expo start`; dev/guides/backend.md §3).
# Empty in dev: the app calls apps/server on the machine Metro runs on, port 3100.
EXPO_PUBLIC_API_URL=

# Sign-in (spec mvp.md §2.0): Supabase production, also in dev (the only database).
# Supabase → Settings → API Keys, the publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
