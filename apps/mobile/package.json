{
  "name": "@sonha/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --dev-client",
    "clear-cache": "node scripts/clear-cache.mjs",
    "start:fresh": "node scripts/clear-cache.mjs && cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --dev-client -c",
    "android": "cross-env EAS_BUILD_PROFILE=development NODE_OPTIONS=--max-old-space-size=4096 expo run:android",
    "android:device": "cross-env EAS_BUILD_PROFILE=development expo run:android --device",
    "android:release": "cross-env EAS_BUILD_PROFILE=production expo run:android --variant release",
    "ios": "cross-env EAS_BUILD_PROFILE=development expo run:ios",
    "prebuild": "cross-env EAS_BUILD_PROFILE=development expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ios": "pnpm dlx eas-cli@25.3.0 build --profile internal-test --platform ios",
    "build:ios:submit": "pnpm dlx eas-cli@25.3.0 build --profile internal-test --platform ios --auto-submit",
    "submit:ios": "pnpm dlx eas-cli@25.3.0 submit --profile internal-test --platform ios --latest"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@react-native-community/datetimepicker": "8.6.0",
    "@sonha/types": "workspace:*",
    "expo": "~55.0.28",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "form-atoms": "4.0.0-next.2",
    "i18next": "25.7.2",
    "i18next-icu": "2.4.1",
    "intl-pluralrules": "2.0.1",
    "jotai": "^2.12.3",
    "jotai-family": "^1.0.2",
    "lodash.memoize": "^4.1.2",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^15.7.4",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~4.3.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "~0.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~55.0.24",
    "cross-env": "^10.1.0",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "expo": {
    "install": {
      "exclude": ["react-native-reanimated", "react-native-worklets"]
    }
  }
}
