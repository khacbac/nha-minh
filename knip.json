{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["apps/mobile"],
  "workspaces": {
    ".": {
      "project": ["dev/*.mjs"]
    },
    "apps/server": {
      "project": "src/**/*.ts",
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/types": {
      "project": "src/**/*.ts"
    }
  }
}
